# Bybit mainnet, субаккаунт для бота ансамбля. BYBIT_TESTNET=1 — переключить на testnet.
BYBIT_API_KEY=your_api_key
BYBIT_API_SECRET=your_api_secret
BYBIT_TESTNET=0
# HTTP-прокси (для SOCKS5: socks5h://user:password@host:1080 и pip install "requests[socks]")
BYBIT_PROXY=http://user:password@host:3128
SYMBOL=BTCUSDT
LEVERAGE=2
POSITION_FRACTION=0.95

# ── Ограничения риска (risk.py) ────────────────────────────────────────────────────────────
# Стоп торговли до ручного возобновления (позиция закрывается):
# просадка equity от пика, %
MAX_DRAWDOWN_PCT=20
# абсолютный минимум equity, USDT
MIN_EQUITY_USDT=100
# убыточных сделок подряд
MAX_CONSECUTIVE_LOSSES=4
# Пауза до 00:00 UTC (позиция закрывается):
# убыток с начала суток UTC, %
DAILY_LOSS_PCT=5
# Ограничения отдельного действия (сделка не выполняется / урезается):
# открытий позиции за сутки UTC
MAX_TRADES_PER_DAY=4
# максимальный размер позиции, USDT
MAX_POSITION_USDT=200
# потолок для LEVERAGE
MAX_LEVERAGE=3
# последняя закрытая свеча не старше, мин
MAX_DATA_DELAY_MIN=90
# расхождение цены свечи и текущей цены, %
MAX_PRICE_DEVIATION_PCT=2
# частота проверок риска между часовыми итерациями, с
RISK_CHECK_SEC=60
